# Copier en .env puis adapter.
# Démo de secours, sans aucune clé : laisser les trois premières lignes telles quelles.
LIGHTNING_MODE=mock      # mock | blink
PAYOUT_MODE=mock         # mock | fedapay
FX_MODE=auto             # auto | fixed

# Blink (LIGHTNING_MODE=blink)
BLINK_API_KEY=
BLINK_WALLET_ID=

# FedaPay (PAYOUT_MODE=fedapay) : payouts activés sur demande (support@fedapay.com)
FEDAPAY_ENV=sandbox      # sandbox | live
FEDAPAY_SECRET_KEY=
# Valeur de "mode" par opérateur (à relever en sandbox), ex. {"BJ:MTN":"...","TG:Togocel":"..."}
FEDAPAY_MODES={}

# Économie (valeurs de démo)
FIXED_BTC_XOF=60000000
SERVICE_FEE_PCT=1.0
PAYOUT_FEE_PCT=0.8      # provisoire, à remplacer par le tarif réel FedaPay
MIN_XOF=500
MAX_XOF=100000

# Route de reprise manuelle : laisser vide pour la désactiver
ADMIN_TOKEN=
